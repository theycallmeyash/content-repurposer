# Copy this file to `.env` and fill in your keys.
# Do NOT commit `.env` to source control.

# Optional: Claude / Anthropic API key (if you have one)
CLAUDE_API_KEY=

# LinkedIn Trend Fetcher - Choose ONE provider
# Option 1: LinkedIn Official API (Free tier, requires OAuth)
LINKEDIN_ACCESS_TOKEN=

# Option 2: RapidAPI (Easier setup, paid plans)
RAPIDAPI_KEY=

# Option 3: Apify (Pre-built scraper, $5 free credits/month)
APIFY_TOKEN=

# Reddit API (Free, for tech/startup trends)
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
